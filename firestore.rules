rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users: 로그인한 본인만 접근 가능
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // analysisResults: 문서 안의 userId 기준
    match /analysisResults/{resultId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.userId;
    }

    // detectedEmails: 문서 안의 userId 기준
    match /detectedEmails/{emailId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.userId;
    }

    // statistics: 문서 ID를 userId로 사용
    match /statistics/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // 위에서 정의하지 않은 나머지 경로는 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
